[Unit]
Description=Frontier Radio API at YJ Janosch Home
Documentation=https://github.com/jttdev/frontier-radio-api/blob/main/deploy/yj-janosch-home/README.md
Requires=docker.service network-online.target
After=docker.service network-online.target
PartOf=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/frontier-radio-api
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do /usr/sbin/ip -4 -o addr show | /usr/bin/grep -q " 10\\.18\\.0\\.13/" && exit 0; /usr/bin/sleep 1; done; echo "Frontier Radio API bind address 10.18.0.13 not present after 60s" >&2; exit 1'
# Recreate after the address exists, so a pre-network bind failure cannot
# leave a restored container running without published ports.
ExecStart=/usr/bin/docker compose -f deploy/yj-janosch-home/compose.yaml up -d --force-recreate --no-build radio-api
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/curl -fsS --max-time 3 "http://10.18.0.13/setupapp/iden/asp/BrowseXML/loginXML.asp?token=0" 2>/dev/null | /usr/bin/grep -Eq "^<EncryptedToken>[[:xdigit:]]+</EncryptedToken>$" && exit 0; /usr/bin/sleep 1; done; echo "Frontier Radio API XML endpoint did not become ready after 30s" >&2; exit 1'
ExecStop=/usr/bin/docker compose -f deploy/yj-janosch-home/compose.yaml stop radio-api
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
